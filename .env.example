# Backend the app talks to. Copy to .env (gitignored) - `make env` does it.
# Compiled in at build time: rebuild after changing it (make ios-sim / make run).
#   Local (iOS simulator):  http://localhost:8000/
#   Cloudflare tunnel:      run `make tunnel-env` to write the live trycloudflare URL
BACKEND_ENDPOINT=http://localhost:8000/
